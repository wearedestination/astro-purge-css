{
	"name": "@destination/astro-purge-css",
	"version": "1.0.1",
	"description": "Astro integration that removes unused CSS from a static build and inlines small stylesheets.",
	"keywords": [
		"astro",
		"astro-integration",
		"purgecss",
		"css"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wearedestination/astro-purge-css.git"
	},
	"bugs": {
		"url": "https://github.com/wearedestination/astro-purge-css/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsdown src/index.ts",
		"check": "biome check",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"astro": "^7.0.0"
	},
	"dependencies": {
		"purgecss": "^8.0.0",
		"purgecss-from-html": "^8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.19.1",
		"astro": "^7.3.6",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	}
}
