{
  "name": "@destination/astro-purge-css",
  "version": "1.1.2",
  "description": "Astro integration that removes unused CSS from a static build and inlines small stylesheets.",
  "keywords": [
    "astro",
    "astro-integration",
    "css",
    "purgecss"
  ],
  "bugs": {
    "url": "https://github.com/wearedestination/astro-purge-css/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wearedestination/astro-purge-css.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "postcss": "^8.5.32",
    "purgecss": "^8.0.0",
    "purgecss-from-html": "^8.0.0"
  },
  "devDependencies": {
    "@destination/oxc-config": "^0.1.0",
    "@types/node": "^24.19.1",
    "astro": "^7.3.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
